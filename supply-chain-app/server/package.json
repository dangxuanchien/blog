{
  "name": "scpaas",
  "version": "1.0.0",
  "description": "Payment project",
  "main": "/src/server.js",
  "scripts": {
    "build": "rm -rf dist && mkdir dist && tsc --project ./",
    "start:prod": "node -r module-alias/register dist/server.js",
    "start:dev": "nodemon -e ts,js --exec ts-node -r tsconfig-paths/register src/server.ts",
    "prettier-format": "prettier --config .prettierrc \"src/**/*.ts\" --write",
    "prettier-watch": "onchange 'src/**/*.ts' -- prettier --write {{changed}}",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "4.1.2",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "dotenv-cli": "^6.0.0",
    "express": "^4.18.2",
    "express-validator": "^6.14.2",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "log4js": "^6.7.1",
    "module-alias": "^2.2.2",
    "nodemon": "^2.0.20",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.1",
    "typeorm": "^0.3.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.15",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/module-alias": "^2.0.1",
    "@types/node": "^18.11.17",
    "@typescript-eslint/eslint-plugin": "^5.46.1",
    "@typescript-eslint/parser": "^5.46.1",
    "concurrently": "^7.6.0",
    "eslint": "^8.30.0",
    "onchange": "^7.1.0",
    "prettier": "^2.8.1",
    "typescript": "^4.9.4"
  },
  "_moduleAliases": {
    "@": "dist",
    "@modules": "./src/modules",
    "@postgresql": "./src/databases/postgresql"
  }
}
